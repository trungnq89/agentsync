# ---- Development (docker-compose.yml + pnpm dev) ----
# Host port of the compose `db` service (change if 5432 is taken)
DB_PORT=5432
DATABASE_URL=postgres://agentsync:agentsync@localhost:5432/agentsync
DATABASE_URL_TEST=postgres://agentsync:agentsync@localhost:5432/agentsync_test
DATABASE_URL_E2E=postgres://agentsync:agentsync@localhost:5432/agentsync_e2e
# Public base URL of this app (used in the MCP config snippet shown in Settings)
APP_URL=http://localhost:3000
# Session cookie `Secure` flag. Default: true when APP_URL starts with https://.
# HTTPS is strongly recommended. Set COOKIE_SECURE=false only for internal plain-HTTP testing.
# COOKIE_SECURE=true

# ---- Production (docker-compose.prod.yml) ----
# Required: password for the bundled Postgres (compose builds DATABASE_URL from it).
# Use only letters, digits, - and _ (it is spliced into a URL).
# POSTGRES_PASSWORD=change-me
# Optional: host port of the app (default 3000)
# APP_PORT=3000
# Optional: only when served behind a reverse proxy with a different Host
# (comma-separated hosts allowed to call Server Actions).
# Build-time: changing it requires `docker compose -f docker-compose.prod.yml up -d --build`.
# ALLOWED_ORIGINS=agentsync.example.com
# Note: no SESSION_SECRET is needed; sessions are random ids stored in the database.
